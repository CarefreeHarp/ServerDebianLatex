% EJE 4. INTERFAZ URBANO-FORESTAL (WUI)
% ---------------------------------------------------------------------

@article{cohen2000preventing,
  author  = {Cohen, Jack D.},
  title   = {Preventing Disaster: Home Ignitability in the Wildland--Urban Interface},
  journal = {Journal of Forestry},
  volume  = {98},
  number  = {3},
  pages   = {15--21},
  year    = {2000},
  doi     = {10.1093/jof/98.3.15},
  url     = {https://research.fs.usda.gov/treesearch/4688},
  abstract    = {Wildland-urban interface (W-UI) fires are a significant concern for federal, state, and local land management and fire agencies. Research using modeling, experiments, and W-UI case studies indicates that home ignitability during wildland fires depends on the characteristics of the home and its immediate surroundings. These findings have implications for hazard assessment and risk mapping, effective mitigations, and identification of appropriate responsibility for reducing the potential for home loss caused by W-UI.},
  author_keywords  = {wildland fire; home ignitability; wildland-urban interface; hazard assessment; risk mapping},
  indexed_keywords = {home ignition zone; structure loss; fire risk mapping; wildland-urban interface; fire mitigation}
}

@article{radeloff2005wui,
  author  = {Radeloff, Volker C. and Hammer, Roger B. and Stewart, Susan I. and Fried, Jeremy S. and Holcomb, Sherry S. and McKeefry, Jason F.},
  title   = {The Wildland--Urban Interface in the United States},
  journal = {Ecological Applications},
  volume  = {15},
  number  = {3},
  pages   = {799--805},
  year    = {2005},
  doi     = {10.1890/04-1413},
  url     = {https://www.frames.gov/catalog/4950},
  abstract    = {The wildland-urban interface (WUI) is the area where houses meet or intermingle with undeveloped wildland vegetation. The WUI is thus a focal area for human-environment conflicts, such as the destruction of homes by wildfires, habitat fragmentation, introduction of exotic species, and biodiversity decline. Our goal was to conduct a spatially detailed assessment of the WUI across the United States to provide a framework for scientific inquiries into housing growth effects on the environment and to inform both national policymakers and local land managers about the WUI and associated issues. The WUI in the conterminous United States covers 719,156 km2 (9\% of land area) and contains 44.8 million housing units (39\% of all houses). WUI areas are particularly widespread in the eastern United States, reaching a maximum of 72\% of land area in Connecticut. California has the highest number of WUI housing units (5.1 million). The extent of the WUI highlights the need for ecological principles in land-use planning as well as sprawl-limiting policies to adequately address both wildfire threats and conservation problems.},
  author_keywords  = {wildland-urban interface; WUI; housing growth; land-use planning; wildfire risk; GIS},
  indexed_keywords = {conservation; fire damage (property); fire management; forest management; fragmentation; GIS - geographic information system; housing growth; land use planning; population density; urban sprawl; urbanization; wildfire management; wildland fire; wildland-urban interface (WUI)}
}

@article{calkin2014risk,
  author  = {Calkin, David E. and Cohen, Jack D. and Finney, Mark A. and Thompson, Matthew P.},
  title   = {How Risk Management Can Prevent Future Wildfire Disasters in the Wildland--Urban Interface},
  journal = {Proceedings of the National Academy of Sciences},
  volume  = {111},
  number  = {2},
  pages   = {746--751},
  year    = {2014},
  doi     = {10.1073/pnas.1315088111},
  url     = {https://www.frames.gov/catalog/52438},
  abstract    = {Recent fire seasons in the western United States are some of the most damaging and costly on record. Wildfires in the wildland-urban interface on the Colorado Front Range, resulting in thousands of homes burned and civilian fatalities, although devastating, are not without historical reference. These fires are consistent with the characteristics of large, damaging, interface fires that threaten communities across much of the western United States. Wildfires are inevitable, but the destruction of homes, ecosystems, and lives is not. We propose the principles of risk analysis to provide land management agencies, first responders, and affected communities who face the inevitability of wildfires the ability to reduce the potential for loss. Overcoming perceptions of wildland-urban interface fire disasters as a wildfire control problem rather than a home ignition problem, determined by home ignition conditions, will reduce home loss.},
  author_keywords  = {risk assessment; fuel treatment; home ignition zone; wildland-urban interface; wildfire disaster},
  indexed_keywords = {Colorado Front Range; fire control; fire damage (property); fire management; fuel management; fuel treatment; HIZ - home ignition zone; land management; risk assessment; wildfires}
}

@article{caton2017pathways,
  author  = {Caton, Sara E. and Hakes, Raquel S. P. and Gorham, Daniel J. and Zhou, Aixi and Gollner, Michael J.},
  title   = {Review of Pathways for Building Fire Spread in the Wildland Urban Interface Part {I}: Exposure Conditions},
  journal = {Fire Technology},
  volume  = {53},
  number  = {2},
  pages   = {429--473},
  year    = {2017},
  doi     = {10.1007/s10694-016-0589-z},
  url     = {https://link.springer.com/article/10.1007/s10694-016-0589-z},
  abstract    = {While the wildland-urban interface (WUI) is not a new concept, fires in WUI communities have rapidly expanded in frequency and severity over the past few decades. The number of structures lost per year has increased significantly, due in part to increased development in rural areas, fuel management policies, and climate change, all of which are projected to increase in the future. This two-part review presents an overview of research on the pathways for fire spread in the WUI. Recent involvement of the fire science community in WUI fire research has led to some great advances in knowledge; however, much work is left to be done. While the general pathways for fire spread in the WUI (radiative, flame, and ember exposure) are known, the exposure conditions generated by surrounding wildland fuels, nearby structures or other system-wide factors, and the subsequent response of WUI structures and communities are not well known or well understood. This first part of the review covers the current state of the WUI and existing knowledge on exposure conditions. Recommendations for future research and development are also presented for each part of the review.},
  author_keywords  = {Wildland urban interface; WUI; Wildfire; Wildland fire; Firebrands; Embers; Fire spread},
  indexed_keywords = {Fire Science, Hazard Control, Building Safety; Building Types and Functions; Natural Hazards; Fire Ecology; Forestry}
}

@article{radeloff2018rapid,
  author  = {Radeloff, Volker C. and Helmers, David P. and Kramer, H. Anu and Mockrin, Miranda H. and Alexandre, Patricia M. and Bar-Massada, Avi and Butsic, Van and Hawbaker, Todd J. and Martinuzzi, Sebasti{\'a}n and Syphard, Alexandra D. and Stewart, Susan I.},
  title   = {Rapid Growth of the {US} Wildland--Urban Interface Raises Wildfire Risk},
  journal = {Proceedings of the National Academy of Sciences},
  volume  = {115},
  number  = {13},
  pages   = {3314--3319},
  year    = {2018},
  doi     = {10.1073/pnas.1718850115},
  url     = {https://www.pnas.org/doi/10.1073/pnas.1718850115},
  abstract    = {The wildland-urban interface (WUI) is the area where houses and wildland vegetation meet or intermingle, and where wildfire problems are most pronounced. Here we report that the WUI in the United States grew rapidly from 1990 to 2010 in terms of both number of new houses (from 30.8 to 43.4 million; 41\% growth) and land area (from 581,000 to 770,000 km2; 33\% growth), making it the fastest-growing land use type in the conterminous United States. The vast majority of new WUI areas were the result of new housing (97\%), not related to an increase in wildland vegetation. Within the perimeter of recent wildfires (1990-2015), there were 286,000 houses in 2010, compared with 177,000 in 1990. Furthermore, WUI growth often results in more wildfire ignitions, putting more lives and houses at risk. Wildfire problems will not abate if recent housing growth trends continue.},
  author_keywords  = {wildland-urban interface; wildfire risk; housing growth; land use change; fire policy},
  indexed_keywords = {environmental sciences; land use; housing density; census data; National Land Cover Database; fire perimeters; wildfire ignitions}
}


