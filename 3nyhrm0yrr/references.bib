@inproceedings{tardivo2016evolutionary,
  author    = {Tardivo, Mar{\'i}a Laura and Caymes-Scutari, Paola and Bianchini, Germ{\'a}n and M{\'e}ndez-Garabetti, Miguel and Cort{\'e}s, Ana},
  title     = {Three Evolutionary Statistical Parallel Methods for Uncertainty Reduction in Wildland Fire Prediction},
  booktitle = {Proceedings of the 2016 International Conference on High Performance Computing \& Simulation (HPCS)},
  publisher = {IEEE},
  pages     = {721--728},
  year      = {2016},
  doi       = {10.1109/HPCSim.2016.7568406},
  url       = {https://ieeexplore.ieee.org/document/7568406/},
  abstract    = {Wildland fires at any location are a result of complex interactions between fuel, forest structure, topography, ignitions and weather conditions. Therefore, there is great interest in the development of computational tools for the prediction of these interactions during a wildland fire. A computational model that attempts to predict the spread of flames must provide a representation of the evolution of the fire over time. However, modelling any natural phenomenon is a difficult task, because models present a series of restrictions due to the need for a large number of input parameters. Moreover, there exist a degree of uncertainty in the input parameter values due to an inability to measure them in real time. To overcome this drawback and improve the quality of the prediction, several methods have been developed. This work presents a comparison of three methods for the reduction of uncertainty in the input parameter values, applied to the prediction of wildland fire behaviour. The three methods uses Parallel Evolutionary Algorithms to guide the search, Statistics to calibrate the results, and Parallelism to enhance the search in time and space terms.},
  author_keywords  = {Wildland Fire Prediction; Statistics; Island Model; Evolutionary Algorithms; Comparative Study; High Performance Computing},
  indexed_keywords = {Statistics; Fires; Uncertainty; Evolutionary computation; Computational modeling; Predictive models; input parameters; prediction quality}
}

@inproceedings{fraga2021urgent,
  author    = {Fraga, Edigley and Cort{\'e}s, Ana and Margalef, Tom{\`a}s and Hern{\'a}ndez, Porfidio},
  title     = {Cloud-Based Urgent Computing for Forest Fire Spread Prediction under Data Uncertainties},
  booktitle = {Proceedings of the 2021 IEEE 28th International Conference on High Performance Computing, Data, and Analytics (HiPC)},
  publisher = {IEEE},
  pages     = {430--435},
  year      = {2021},
  doi       = {10.1109/HiPC53243.2021.00061},
  url       = {https://ieeexplore.ieee.org/document/9680355/},
  abstract    = {Forest fires severely affect many ecosystems every year, leading to large environmental damages, casualties, and economic losses. Emerging and established technologies are used to help wildfire analysts determine fire behavior and spread, aiming at more accurate prediction results and efficient use of resources in fire fighting. We propose a novel forest fire spread prediction platform based on a proven two-stage prediction model devised to deal with input data uncertainties. The model is able to calibrate the unknown parameters based on the real observed data using an iterative process. Since this calibration is compute-intensive and due to the unpredictability of urgent computing needs, we exploit an elastic and scalable cloud-based solution platform implemented through coarse-grain parallel processing using a work queue.},
  author_keywords  = {cloud computing; data uncertainty; forest fires; urgent computing},
  indexed_keywords = {Cloud computing; Uncertainty; Costs; Computational modeling; High performance computing; Forestry; Predictive models; two-stage method; prediction accuracy; computational resources}
}

@inproceedings{canales2025edge,
  author    = {Canales, Yonathan and Carrillo, Carlos and Tirado, Felipe},
  title     = {Edge Computing vs. Cloud Computing for Wildland Fire Simulation: A Comparative Analysis Using {CUDA}-Accelerated {FARSITE} Models},
  booktitle = {Proceedings of the 2025 44th International Conference of the Chilean Computer Science Society (SCCC)},
  publisher = {IEEE},
  pages     = {1--8},
  year      = {2025},
  doi       = {10.1109/SCCC67219.2025.11420791},
  url       = {https://ieeexplore.ieee.org/document/11420791/},
  abstract    = {Accurate and efficient prediction of wildland fire spread is crucial for mitigating its devastating impacts on ecosystems, communities, and economies. One of the main challenges in wildland fire simulation is achieving an optimal balance between computational performance, energy efficiency, and scalability, particularly in resource-constrained environments such as un-crewed aerial vehicles. This study evaluates the performance of a FARSITE-based fire simulator parallelized with CUDA across three computing platforms: the NVIDIA Jetson AGX Xavier, the NVIDIA Jetson AGX Orin, and an NVIDIA T4 GPU instance in Microsoft Azure. The research compares edge and cloud computing environments, analyzing their advantages and limitations in terms of simulation speed and energy efficiency. The methodology employed standardized experimental conditions, using a real wildfire in Sao Joaninho, Portugal, as a case study. Different simulation time windows of 5, 10, and 24 hours and spatial resolutions of 5, 10, 25, 50, and 100 meters were evaluated to assess platform performance. Key metrics included total simulation runtime and energy consumption to determine platform suitability for near-real-time applications. Results show that the cloud-based NVIDIA T4 platform achieved significantly faster simulation times, particularly in high-resolution scenarios, due to its higher computational capacity. In contrast, the Jetson AGX Xavier and Jetson AGX Orin platforms delivered acceptable but more limited performance, making them suitable for edge-computing contexts where cloud connectivity is unavailable. These findings support informed platform selection for wildland fire management and real-time decision support, balancing performance and energy efficiency.},
  author_keywords  = {Low-consumption GPUs; Energy-efficient computing; cloud computing; Wildfire simulation},
  indexed_keywords = {Performance evaluation; Cloud computing; Wildfires; Accuracy; Computational modeling; Scalability; Graphics processing units; Forestry; Real-time systems; edge computing; energy consumption; parallelization}
}


