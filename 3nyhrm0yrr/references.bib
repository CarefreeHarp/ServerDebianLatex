	title = {A comparison of three approaches for simulating fine-scale surface winds in support of wildland fire management. Part II. An exploratory study of the effect of simulated winds on fire growth simulations},
	year = {2014},
	journal = {International Journal of Wildland Fire},
	volume = {23},
