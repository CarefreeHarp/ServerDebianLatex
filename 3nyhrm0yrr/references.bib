@CONFERENCE{Canales2025,
	author = {Canales, Yonathan and Carrillo, Carlos and Tirado, Felipe},
	title = {Edge Computing vs. Cloud Computing for Wildland Fire Simulation: A Comparative Analysis Using CUDA-Accelerated FARSITE Models},
	year = {2025},
	journal = {Proceedings - International Conference of the Chilean Computer Science Society, SCCC},
	pages = {},
	doi = {10.1109/SCCC67219.2025.11420791},
	url = {https://www.scopus.com/pages/publications/105035836894?origin=resultslist},
	affiliations = {Universidad Católica Del Maule, Department of Computing and Industries, Talca, Chile; Universidad Autónoma de Barcelona, Computer Architecture and Operating System Department, Barcelona, Spain},
	abstract = {Accurate and efficient prediction of wildland fire spread is crucial for mitigating its devastating impacts on ecosystems, communities, and economies. One of the main challenges in wildland fire simulation is achieving an optimal balance between computational performance, energy efficiency, and scalability, particularly in resource-constrained environments such as un-crewed aerial vehicles. This study evaluates the performance of a FARSITE-based fire simulator parallelized with CUDA across three computing platforms: the NVIDIA Jetson AGX Xavier, the NVIDIA Jetson AGX Orin, and an NVIDIA T4 GPU instance in Microsoft Azure. The research compares edge and cloud computing environments, analyzing their advantages and limitations in terms of simulation speed and energy efficiency. The methodology employed standardized experimental conditions, using a real wildfire in São Joaninho, Portugal, as a case study. Different simulation time windows of 5, 10, and 24 hours and spatial resolutions of 5, 10, 25, 50, and 100 meters were evaluated to assess platform performance. Key metrics included total simulation runtime and energy consumption to determine platform suitability for near-real-time applications. Results show that the cloud-based NVIDIA T4 platform achieved significantly faster simulation times, particularly in high-resolution scenarios, due to its higher computational capacity. In contrast, the Jetson AGX Xavier and Jetson AGX Orin platforms delivered acceptable but more limited performance, making them suitable for edge-computing contexts where cloud connectivity is unavailable. These findings support informed platform selection for wildland fire management and real-time decision support, balancing performance, energy efficiency, operational constraints, and deployment scenarios in practice under realistic operational conditions worldwide. © 2025 IEEE.},
	author_keywords = {cloud computing; Energy-efficient computing; Low-consumption GPUs; Wildfire simulation},
	keywords = {Antennas; Cloud platforms; Computational efficiency; Edge computing; Energy efficiency; Fighter aircraft; Fires; Graphics processing unit; Green computing; Program processors; Simulation platform; Windows operating system; Cloud-computing; Edge computing; Energy-efficient computing; Fire simulation; Low consumption; Low-consumption GPU; Performance; Performance\energy efficiency; Wildfire simulation; Wildland fire; Decision support systems},
