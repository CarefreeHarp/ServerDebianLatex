@ARTICLE{Mueller20141534,
	author = {Mueller, Eric and Mell, William and Simeoni, Albert},
	title = {Large eddy simulation of forest canopy flow for wildland fire modeling},
	year = {2014},
	journal = {Canadian Journal of Forest Research},
	volume = {44},
	number = {12},
	pages = {1534 - 1544},
	doi = {10.1139/cjfr-2014-0184},
	url = {https://www.scopus.com/pages/publications/84911376148?origin=resultslist},
	affiliations = {University of Edinburgh, BRE Centre for Fire Safety Engineering, Edinburgh, United Kingdom; USDA Forest Service, Pacific Wildland Fire Sciences Laboratory, Seattle, WA, United States},
	abstract = {Large eddy simulation (LES) based computational fluid dynamics (CFD) simulators have obtained increasing attention in the wildland fire research community, as these tools allow the inclusion of important driving physics. However, due to the complexity of the models, individual aspects must be isolated and tested rigorously to ensure meaningful results. As wind is a driving force that can significantly dictate the behavior of a wildfire, the simulation of wind is studied in the context of a particular LES CFD model, the Wildland-urban interface Fire Dynamics Simulator (WFDS). As WFDS has yet to be tested extensively with regard to wind flow within and above forest canopies, a study of its ability to do so is carried out. First, three simulations are conducted using periodic boundary conditions. Two of these assume a spatially heterogeneous forest and one models wind downstream of a canopy edge. Second, two simulations are conducted with specified “inflow” conditions using two inflow profiles: one static and one dynamic (driven by a precursor simulation). Using periodic boundary conditions, the model is found to generate profiles of mean velocity and turbulent statistics that are representative of experimental measurements. The dynamic inflow scenario is found to perform better than the static case. © 2014, National Research Council of Canada. All rights reserved.},
	author_keywords = {Canopy; Computational fluid dynamics; Large eddy simulation; Wildland fire; Wind},
	keywords = {Forest Canopy; Forest Fires; Models; Simulation; Wind; Boundary conditions; Computational fluid dynamics; Fires; Forestry; Wind; Canopy; Fire dynamics simulator; Forest canopies; Mean velocities; Periodic boundary conditions; Turbulent statistics; Wildland fire; Wildland urban interface; boundary condition; computational fluid dynamics; flow velocity; forest canopy; forest fire; inflow; interface; simulation; wind profile; Large eddy simulation},
	publisher = {Canadian Science Publishing},
