@ARTICLE{Benben20221575,
	author = {Benben, Xu and Weiye, Wang and Liangfu, Chen and Jinhua, Tao and Xuanyu, Ji and Chengjie, Zhang and Meng, Fan},
	title = {Forest fire spread simulation based on VIIRS active fire data and FARSITE model; [VIIRS 火点数据和 FARSITE 系统的森林火灾蔓延模拟]},
