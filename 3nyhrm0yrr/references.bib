}

@BOOK{McDonough200545,
	author = {McDonough, J.M. and Yang, T.},
	title = {Parallel Performance of a New Model for Wildland Fire Spread Predictions},
	year = {2005},
	journal = {Parallel Computational Fluid Dynamics 2004: Multidisciplinary Applications},
	pages = {45 - 51},
	doi = {10.1016/B978-044452024-1/50006-3},
	url = {https://www.scopus.com/pages/publications/84902066307?origin=resultslist},
	affiliations = {Department of Mechanical Engineering, University of Kentucky, Lexington KY 40506-0503, United States},
	abstract = {This chapter presents a new approach to simulation of wildland fire spread. The fire spread model is based on a porous medium representation of a forest with heat source terms replacing treatment of detailed chemistry. The formulation is implemented in conjunction with a synthetic-velocity form of large-eddy simulation (LES), which is capable of producing far more detailed results than can be obtained with usual forms of LES, but yet is very efficient and easily parallelized. The chapter describes the current progress on a more intensive approach to simulating wildland fire evolution. Preliminary results of computations and parallelization of the algorithms are presented and discussed in the chapter. To obtain results that are truly useful to firefighters, the model employed must be completely deterministic in that fluid motion and heat transfer must be computed from (at least) the Navier-Stokes and thermal energy equations. Moreover, this must be done for a range of scales that spans the important details of the forest (including locations of houses and other structures at the wildland/urban interface) and covers distances corresponding to at least microscale meteorology. © 1996 Elsevier B.V. All rights reserved.},
	author_keywords = {Forest fire spread; Large-eddy simulation; Parallelization},
	keywords = {Deforestation; Heating; Large eddy simulation; Navier Stokes equations; Porous materials; Detailed chemistry; Fire spread model; Forest fire spread; New approaches; Parallel performance; Parallelizations; Thermal energy equation; Wildland fire; Fires},
	correspondence_address = {J.M. McDonough; Department of Mechanical Engineering, University of Kentucky, Lexington KY 40506-0503, United States; email: jmmcd@uky.edu},
	publisher = {Elsevier B.V.},
	isbn = {978-044452024-1},
