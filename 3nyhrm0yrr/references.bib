	source = {Scopus},
	note = {Cited by: 0; Conference name: 52nd International Conference on Parallel Processing Workshop, ICPP Workshops 2023; Conference sponsors: ; Conference code: 192763; Conference date: 7 August 2023 through 10 August 2023; All Open Access; Gold Open Access; Green Open Access}
