@article{pastor2003mathematical,
  author  = {Pastor, Elsa and Z{\'a}rate, Luis and Planas, Eul{\`a}lia and Arnaldos, Josep},
  title   = {Mathematical Models and Calculation Systems for the Study of Wildland Fire Behaviour},
  journal = {Progress in Energy and Combustion Science},
  volume  = {29},
  number  = {2},
  pages   = {139--153},
  year    = {2003},
  doi     = {10.1016/S0360-1285(03)00017-0},
  url     = {https://www.sciencedirect.com/science/article/abs/pii/S0360128503000170},
  abstract    = {This is a review of the most important work in wildland fire mathematical modelling which has been carried out at different research centres around the world from the beginning of the 1940s to the present. A generic classification is proposed which allows wildland fire models to be sorted. Surface fire spread models, crown fire initiation and spread models, spotting and ground fire models are reviewed historically and the most significant ones are analysed in depth. The last two sections are dedicated to wildland fire behaviour calculation systems based on the reviewed models. The evolution and complexity of these systems is analysed in parallel with the development of new technologies. Special attention is given to the tools most commonly in current use by forestry agencies.},
  author_keywords  = {Wildland fire; Surface fire; Crown fire; Ground fire; Spotting; Modelling; Simulation},
  indexed_keywords = {fire behaviour calculation systems; empirical models; physical models; forest fire management tools; review}
}

