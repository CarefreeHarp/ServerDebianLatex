	title = {Les simulation of wind-driven wildfire interaction with idealized structures in the wildland-urban interface},
	year = {2021},
	journal = {Atmosphere},
	volume = {12},
	number = {1},
	pages = {1 - 17},
	doi = {10.3390/atmos12010021},
	url = {https://www.scopus.com/pages/publications/85098624520?origin=resultslist},
	affiliations = {School of Mechanical Engineering, University of Tehran, Tehran, 14395-515, Iran; School of Engineering and Information Technology, UNSW Canberra, Canberra, 2612, ACT, Australia; School of Science, UNSW Canberra, Canberra, 2612, ACT, Australia},
	abstract = {This paper presents a numerical investigation of the impact of a wind-driven surface fire, comparable to a large wildfire, on an obstacle located downstream of the fire source. The numerical modelling was conducted using FireFOAM, a coupled fire-atmosphere model underpinned by a large eddy simulation (LES) solver, which is based on the Eddy Dissipation Concept (EDC) combustion model and implemented in the OpenFOAM platform (an open source CFD tool). The numerical data were validated using the aerodynamic measurements of a full-scale building model in the absence of fire effects. The results highlighted the physical phenomena contributing to the fire spread pattern and its thermal impact on the building. In addition, frequency analysis of the surface temperature fluctuations ahead of the fire front showed that the presence of a building influences the growth and formation of buoyant instabilities, which directly affect the behaviour of the fire’s plume. The coupled fire-atmosphere modelling presented here constitutes a fundamental step towards better understanding the behaviour and potential impacts of large wind-driven wildland fires in wildland-urban interface (WUI) areas. © 2020 by the authors. Licensee MDPI, Basel, Switzerland.},
	author_keywords = {Bushfire; FireFOAM; LES; Wildfire; Wildland-urban interface; Wind-driven fire},
	keywords = {Computational fluid dynamics; Large eddy simulation; Aerodynamic measurements; Atmosphere modeling; Eddy dissipation concept; Frequency Analysis; Numerical investigations; Physical phenomena; Surface temperatures; Wildland urban interface; aerodynamics; atmospheric modeling; bushfire; energy dissipation; large eddy simulation; wildfire; wind-driven circulation; Fires},
	correspondence_address = {M. Ghodrat; School of Engineering and Information Technology, UNSW Canberra, Canberra, 2612, Australia; email: m.ghodrat@adfa.edu.au; J.J. Sharples; School of Science, UNSW Canberra, Canberra, 2612, Australia; email: j.sharples@adfa.edu.au},
	publisher = {MDPI AG},
	issn = {20734433},
	language = {English},
