@ARTICLE{McCarthy20211,
	author = {McCarthy, Nicholas F. and Tohidi, Ali and Aziz, Yawar and Dennie, Matt and Valero, Mario Miguel and Hu, Nicole},
	title = {A deep learning approach to downscale geostationary satellite imagery for decision support in high impact wildfires},
	year = {2021},
