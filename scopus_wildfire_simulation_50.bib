@ARTICLE{Artés2016594,
	author = {Artés, Tomàs and Cencerrado, Andrés and Cortés, Ana and Margalef, Tomàs},
	title = {Real-time genetic spatial optimization to improve forest fire spread forecasting in high-performance computing environments},
	year = {2016},
