  author    = {Rodr{\'i}guez, Roque and Cort{\'e}s, Ana and Margalef, Tom{\'a}s},
  title     = {Data Injection at Execution Time in Grid Environments Using Dynamic Data Driven Application System for Wildland Fire Spread Prediction},
