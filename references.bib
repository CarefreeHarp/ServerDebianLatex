  year    = {2019},
  doi     = {10.1007/s10694-019-00846-4},
  url     = {https://link.springer.com/article/10.1007/s10694-019-00846-4},
  abstract    = {A wildland fire spread model was developed using a deep convolutional inverse graphics network (DCIGN) to reduce the computational cost associated with predicting wildland fire spread. The network was trained and tested on landscapes with homogeneous and complex terrain, generating more than 10,000 predictions of burn maps at 6-hour intervals up to 24 hours after ignition. Predictions showed strong agreement with the simulation outputs used as ground truth, with mean precision, sensitivity, F-measure, and Chan--Vese similarity of 0.97, 0.92, 0.93, and 0.93, respectively, and a computational cost three orders of magnitude lower than that of current models, while remaining accurate under noisy input parameters.},
